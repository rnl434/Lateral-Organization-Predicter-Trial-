;;;;;; Martini lipid topology for C16:0/18:1 PI (POPI), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname POPI -alhead 'PI' -allink 'G G' -altail 'CDCC cCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylinositol (PI) lipid corresponding to atomistic C16:0/18:1 1-palmitoyl-2-oleoyl (POPI) tails.
; Parameterization:
;   The lipid head parameters are based on referance atomistic CHARMM36m simulations, see Borges-Araujo et al. 2021 for details. 
;   The lipid tail follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Tail bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
;   L. Borges-Araujo, P.C.T. Souza, F. Fernandes and M.N. Melo. Improved Parameterization of Phosphatidylinositide 
;   Lipid Headgroups for the Martini 3 Coarse-Grain Force Field, JCTC, 2021. doi:10.1021/acs.jctc.1c00615 
;   K.B. Pedersen et al. The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behaviour, TBD 2024 
;   P.C.T. Souza et al. Martini 3: a general purpose force field for coarse-grained molecular dynamics, 
;   Nat. Methods; 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL1-C1A-D2A-C3A-C4A
;  |
; GL2-C1B-C2B-C3B-C4B
;
;  6 - 8 - 9 - 10- 11
;  |
;  7 - 12- 13- 14- 15
;
;@INSANE alhead=PI, allink=G G, altail=CDCC CCCC, alname=POPI, charge=-1.0
;@RESNTEST POP==POPI if: atoms[0]==C1 and atoms[4]==GL1
;@BEADS C1 C2 C3 C4 PO4 GL1 GL2 C1A D2A C3A C4A C1B C2B C3B C4B 
;@BONDS C1-C2 C1-C3 C2-C3 C1-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-D2A D2A-C3A C3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

[moleculetype]
; molname      nrexcl
  POPI          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    SP1   1  POPI   C1   1 	0
   2   SP4r   1  POPI   C2   2 	0
   3   SP4r   1  POPI   C3   3 	0
   4    TC4   1  POPI   C4   4 	0 	0 	; Massless virtual bead
   5     Q5   1  POPI  PO4   5 	-1.0
   6   SN4a   1  POPI  GL1   6 	0
   7   SN4a   1  POPI  GL2   7 	0
   8     C1   1  POPI  C1A   8 	0
   9    C4h   1  POPI  D2A   9 	0
  10     C1   1  POPI  C3A  10 	0
  11     C1   1  POPI  C4A  11 	0
  12    SC1   1  POPI  C1B  12 	0
  13     C1   1  POPI  C2B  13 	0
  14     C1   1  POPI  C3B  14 	0
  15     C1   1  POPI  C4B  15 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
#ifdef FLEXIBLE
; Using bonds not constraints
   1  2   1 	0.3720 	30000
   1  3   1 	0.3696 	30000
   2  3   1 	0.4044 	30000
#endif
; Phosphodiester and glycerol backbone
   1  5   1 	0.33  	 5000 	; C1 PO4
   5  6   1 	0.368 	 2250      ; PO4 GL1
   5  7   1 	0.518 	 600 	     ; PO4 GL2
; Lipid tail (uses standard Martini tail rules)
   6  7 	b_GL_GL_glyc
   6  8 	b_GL_C1_glyc_5long
   8  9 	b_C1_C4_mid_5long
   9 10 	b_C4_C1_mid
  10 11 	b_C1_C1_end
   7 12 	b_GL_SC1_glyc
  12 13 	b_SC1_C1_mid
  13 14 	b_C1_C1_mid
  14 15 	b_C1_C1_end

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
; Orient the headgroup
   2  1  5  10 	100.0 	15.0 	; C2 C1 PO4
   1  5  6  10 	100.0 	 4.0 	; C1 PO4 GL1
; Tail part (uses standard Martini tail rules)
   7  6  8 	a_GL_GL_C_glyc
   6  7 12 	a_GL_GL_C_glyc
   6  8  9 	a_GL_C1_C4_glyc
   8  9 10 	a_C1_C4_C1_def
   9 10 11 	a_C4_C1_C1_def
   7 12 13 	a_GL_C1_C1_glyc
  12 13 14 	a_C1_C1_C1_def
  13 14 15 	a_C1_C1_C1_def

[dihedrals]
;  i  j  k  l 	name 	(using named dihedraltypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k  l 	funct 	angle 	force.c.
; Orient the headgroup
   3  2  1  5   2 	-148 	95.0 	 	; C3 C2 C1 PO4
   2  1  5  6   1 	180 	2.0 	2 	; C3 C2 C1 PO4

[constraints]
;  i  j  k 	funct 	length
#ifndef FLEXIBLE
; Using constraints not bonds
   1  2 	1 	0.3720 	; C1 C2   Expanded 20% to account for SASA
   1  3 	1 	0.3696 	; C1 C3
   2  3 	1 	0.4044 	; C2 C3
#endif

[ virtual_sitesn ]
; site funct  constructing atom indices
   4     2     1 2 3

[exclusions]
; i  j  k  ...
  4 3 2 1 5
  3 2 1
  2 1


#ifdef POSRES_HEAD
[ position_restraints ]
; ai  funct  fcx    fcy    fcz
   5    1    1000   1000   1000
#endif


